<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ============================================================
    Zentwik.UI —— WPF 壳子（批次四）
    ============================================================

    【本工程只做壳子】
    能启动、能拉起 Worker、能 ping 通、托盘能显示、关闭行为按配置执行。
    调校页 / 进程页 / 日志页 / 配置页全部留到后续批次。

    【为什么是 WinExe】
    双击不能弹黑色 Console 窗口。写成 Exe 后编译、运行、日志全都正常，
    只有用户双击时才会看到黑框 —— 与 Worker 的同名红线（批次红线清单 §2.1）同一个失败模式。

    【为什么 UseWindowsForms 也要开】
    docs/项目事实卡.md §7.2 写死了托盘实现：UI 进程用 WinForms NotifyIcon 创建，
    Worker 不持有任何托盘。WPF 没有托盘 API；第三方托盘库在多一个依赖之外，
    AOT / 裁剪下的行为也不可控。

    【为什么 UI 是 asInvoker】
    事实卡 §5.1：UI 侧零提权，所有需要管理员令牌的操作一律走 IPC 交给 Worker。
    清单级别（app.manifest）是这条架构线的物理保证，不是注释。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Zentwik.UI</RootNamespace>
    <AssemblyName>Zentwik.UI</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>

    <!-- exe 与安装包共用同一份图标：iss 的 SetupIconFile 指向 Assets\Zentwik.ico，
         这里不设的话，复制过来的 ico 只对安装包生效，Zentwik.UI.exe 在资源管理器里
         仍是一个空白默认图标。 -->
    <ApplicationIcon>Assets\Zentwik.ico</ApplicationIcon>

    <!--
      WFO0003：WinForms 分析器要求「把高 DPI 设置从清单里删掉，改用 Application.SetHighDpiMode」。

      这条建议的前提是入口点为 WinForms 的 Application.Run。本工程入口点是 WPF
      （App.xaml 生成的 Main），从不调用 ApplicationConfiguration.Initialize() 或
      SetHighDpiMode —— WinForms 在这里只用来承载托盘 NotifyIcon。
      而 WPF 的 DPI 感知只能来自进程清单：删掉 dpiAwareness，主窗口在非主显示器上
      会按系统 DPI 位图拉伸，文字发虚，且没有任何 API 能在运行期补回来。

      两个选项的实际后果：
        · 按建议删清单 → WPF 掉回 System DPI，主窗口发虚（真损失）；
        · 保留清单 + 抑制告警 → WinForms 托盘图标不受影响（托盘图标本来就由 shell 缩放）。
      取后者。这是显式抑制，不是「消掉警告」的偷懒：编译红线是 0 警告，
      而这条告警指向的修复会引入真实缺陷。
    -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zentwik.Core\Zentwik.Core.csproj" />
  </ItemGroup>

</Project>
