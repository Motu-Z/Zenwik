<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe 而不是 Exe：双击不能弹黑色 Console 窗口。
         写成 Exe 后编译、运行、日志全都正常，只有用户双击时才会看到黑框。 -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- 提权清单：Worker 的全部职责（SMU 写入 / 任务计划 / 注册表）都要求管理员令牌。 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zentwik.Core\Zentwik.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
  </ItemGroup>

</Project>
