<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Zentwik.App.Views.TuningPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Zentwik.App.ViewModels"
    xmlns:ctl="using:Zentwik.App.Controls"
    xmlns:local="using:Zentwik.App"
    Background="Transparent">

    <!--
    ============================================================================
    调校页 —— 按 UI_Contract v1.4 全量 x:Bind 实现
    ============================================================================
    数值输入纯 TextBox（契约入口 EditText / FMaxText / ParkingText，34px / Consolas /
    居中）。隐式步进：Grid 叠加「纯 TextBox + 左右两个 Button」，命令直接绑在按钮上。

    【红线一：核心网格用 ListView + ItemsWrapGrid，不用 ItemsRepeater】
    两个 WinAppSDK 2.x 的 API 事实，写错就编译不过（别改回去）：
    1. 属性名是 ListView.ItemsPanel，不是 ListView.ItemsPanelTemplate ——
       后者在 2.x 已不存在，编译器报 WMC0011 / WMC0090（unknown member）。
       但它的**类型仍是 ItemsPanelTemplate**，所以要再套一层 <ItemsPanelTemplate>。
    2. ListView 没有 IsScrollEnabled 属性。要关掉内部滚动、让整页统一滚动，
       用 ScrollViewer.VerticalScrollMode / VerticalScrollBarVisibility = Disabled
       （这两个挂在 ListView 上会传到它的内部 ScrollViewer），
       否则两层滚动器嵌套会互相抢滚轮，表现为滚轮在核心网格里滚不动整页。
    ItemWidth / ItemHeight 必须显式给值：
    ItemsWrapGrid 在缺省（NaN）时按首个元素的期望尺寸排版，每格宽度会随内容浮动，8 列不再等宽。

    【红线二：不用 ControlTemplate 重写 TextBox】
    旧实现把加减号塞进 TextBox.Template 里，命令靠 TextBox.Tag（减）/ Header（加）
    穿透、模板内 Button 用 {TemplateBinding} 取 —— 这条路要顶掉 TextBox 自带的
    ContentElement 命名部件，非打包模式下是黑屏 / 闪退的高发点。
    现在改成 Grid 叠加：TextBox 在底层，左右两个 Button 压在上面，
    命令直接 Command= 绑定。零穿透、零反射、AOT 安全。

    【红线三：全页不使用 TabView】

    【代价：加减号不再「悬浮 / 聚焦才淡入」】
    淡入依赖 TextBox 模板的 PointerOver / Focused 视觉状态，
    模板被红线禁用后拿不到这两个状态。加减号改为常驻显示，
    样式仍走 AppStepperButton（透明底 + 次级字色，悬浮自身浮出浅底）。

    步进命令（契约 v1.4）：
      CoreSlotViewModel.IncrementCommand / DecrementCommand（±1，钳制 -50~+50）；
      TuningViewModel.IncrementCommand / DecrementCommand（IRelayCommand<string>，
      参数 "FMax" / "Parking"，内部调 MarkDirty() 走脏数据链）。
    ============================================================================
    -->

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="{StaticResource AppContentPadding}">
            <StackPanel Spacing="16">

                <TextBlock x:Uid="Tuning_Title"
                           Style="{StaticResource AppPageTitle}"
                           Margin="0,0,0,8" />

                <!-- 提示条：只承载 Error / Warning（后端置 IsStatusVisible）；成功不占首屏 -->
                <InfoBar IsOpen="{x:Bind ViewModel.IsStatusVisible, Mode=TwoWay}"
                         IsClosable="True"
                         Severity="{x:Bind local:UiConverters.ToInfoBarSeverity(ViewModel.StatusLevel), Mode=OneWay}"
                         Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}">
                    <InfoBar.Resources>
                        <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
                    </InfoBar.Resources>
                </InfoBar>

                <!-- ==================== CPU 卡片 ==================== -->
                <Border Style="{StaticResource AppCard}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 同步：SMU 不可用时后端不硬读、直接告警，按钮保持可点以便恢复后重试 -->
                        <Button Grid.Column="0"
                                x:Uid="Tuning_Refresh"
                                Style="{StaticResource AppIconButton}"
                                Command="{x:Bind ViewModel.RefreshCommand}"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>

                        <!-- 主标题只放型号，规格与 SMU 状态下沉到副标题。
                             后端 CpuName 是一整串 "AMD Ryzen 9 9955HX 16-Core Processor"，
                             挤在一行会被截断；契约 v1.6 的 CpuTitle / CpuDetail 就是拆好的两段：
                             CpuTitle = 型号，CpuDetail = 规格 · SMU 状态。
                             CpuSubText（核心代号 / SMU 版本）降级为副标题的悬浮提示，不丢信息。 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.CpuTitle, Mode=OneWay}"
                                       Style="{StaticResource AppCpuName}"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind ViewModel.CpuDetail, Mode=OneWay}"
                                       Style="{StaticResource AppDesc}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.CpuSubText, Mode=OneWay}" />
                        </StackPanel>

                        <!-- 方案下拉 + 应用：一组操作，间距 8，高度对齐 AppComboHeight -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Grid MinWidth="150">
                                <ctl:AppComboBox ItemsSource="{x:Bind ViewModel.ProfileOptions, Mode=OneWay}"
                                                 SelectedIndex="{x:Bind ViewModel.ProfileIndex, Mode=TwoWay}" />
                                <!-- 脏数据星号：契约 2.1 —— IsDraftDirty 唯一用途即此角标 -->
                                <TextBlock Text="*"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource AppAccentBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"
                                           Margin="0,-8,2,0"
                                           IsHitTestVisible="False"
                                           Visibility="{x:Bind local:UiConverters.ToVisibleWhenTrue(ViewModel.IsDraftDirty)}" />
                            </Grid>
                            <Button x:Uid="Tuning_Apply"
                                    Height="{StaticResource AppComboHeight}"
                                    Style="{StaticResource AppButtonPrimary}"
                                    Command="{x:Bind ViewModel.ApplyCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================== CO 卡片 ==================== -->
                <Border Style="{StaticResource AppCard}">
                    <StackPanel Spacing="16">
                        <TextBlock x:Uid="Tuning_CoTitle"
                                   Style="{StaticResource AppCardTitle}" />

                        <!-- 空态：HasCores == false 时网格整块收起 -->
                        <Border Style="{StaticResource AppInnerPanel}"
                                Visibility="{x:Bind local:UiConverters.ToVisibleWhenTrue(ViewModel.IsCoreGridEmpty)}">
                            <TextBlock x:Uid="Tuning_CoEmpty"
                                       Style="{StaticResource AppDesc}"
                                       HorizontalAlignment="Center" />
                        </Border>

                        <!-- 8 列等分流式布局；格数 = Cores.Count，严禁写死。
                             红线一：ListView + ItemsWrapGrid，不用 ItemsRepeater。
                             ListView.ItemsPanel 的类型是 ItemsPanelTemplate（2.x 的写法，
                             属性名与类型名不一致，见页头注释）。 -->
                        <ListView ItemsSource="{x:Bind ViewModel.Cores, Mode=OneWay}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  Padding="0"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  Visibility="{x:Bind local:UiConverters.ToVisibleWhenTrue(ViewModel.HasCores)}">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal"
                                                   MaximumRowsOrColumns="8"
                                                   ItemWidth="92"
                                                   ItemHeight="{StaticResource AppInputHeight}" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <!-- 默认 ListViewItem 带 12px 内缩与选中底色，
                                         这里只保留 8px 的格子间距，其余全部归零 -->
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,8,8" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="UseSystemFocusVisuals" Value="False" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:CoreSlotViewModel">
                                    <!-- 红线二：Grid 叠加「纯 TextBox + 左右两个 Button」。
                                         命令直接绑在按钮上（每格自带命令，入口即身份）。 -->
                                    <Grid Width="92" Height="{StaticResource AppInputHeight}">
                                        <TextBox Style="{StaticResource AppTextBoxMono}"
                                                 MaxLength="4"
                                                 Text="{x:Bind EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="OnCoTextChanged" />
                                        <Button Style="{StaticResource AppStepperButton}"
                                                Width="18" Height="28"
                                                Margin="2,0,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Content="&#x2013;"
                                                IsTabStop="False"
                                                Command="{x:Bind DecrementCommand}" />
                                        <Button Style="{StaticResource AppStepperButton}"
                                                Width="18" Height="28"
                                                Margin="0,0,2,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Content="+"
                                                IsTabStop="False"
                                                Command="{x:Bind IncrementCommand}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- ==================== FMax 卡片 ====================
                     契约 v1.2：IsEnabled 硬闸门绑 IsFMaxSupported -->
                <Border Style="{StaticResource AppCard}">
                    <Grid ColumnSpacing="16">
                        <TextBlock x:Uid="Tuning_FMaxTitle"
                                   Style="{StaticResource AppCardTitle}"
                                   VerticalAlignment="Center" />
                        <!-- IsEnabled 只能设在 Control 上：ContentControl 仅作闸门容器 -->
                        <ContentControl Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        IsTabStop="False"
                                        IsEnabled="{x:Bind ViewModel.IsFMaxSupported, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <!-- 红线二：Grid 叠加，命令直接绑定。
                                     参数 "FMax"，±步进钳制 400~5400，内部须调 MarkDirty()。 -->
                                <Grid Width="80" Height="{StaticResource AppInputHeight}">
                                    <TextBox Style="{StaticResource AppTextBoxMono}"
                                             MaxLength="4"
                                             Text="{x:Bind ViewModel.FMaxText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextChanged="OnFMaxTextChanged" />
                                    <Button Style="{StaticResource AppStepperButton}"
                                            Width="18" Height="28"
                                            Margin="2,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Content="&#x2013;"
                                            IsTabStop="False"
                                            Command="{x:Bind ViewModel.DecrementCommand}"
                                            CommandParameter="FMax" />
                                    <Button Style="{StaticResource AppStepperButton}"
                                            Width="18" Height="28"
                                            Margin="0,0,2,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Content="+"
                                            IsTabStop="False"
                                            Command="{x:Bind ViewModel.IncrementCommand}"
                                            CommandParameter="FMax" />
                                </Grid>
                                <TextBlock x:Uid="Tuning_MhzUnit"
                                           Style="{StaticResource AppDesc}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ContentControl>
                    </Grid>
                </Border>

                <!-- ==================== 电源策略卡片 ==================== -->
                <Border Style="{StaticResource AppCard}">
                    <StackPanel Spacing="16">
                        <TextBlock x:Uid="Tuning_PowerTitle" Style="{StaticResource AppCardTitle}" />

                        <Grid ColumnSpacing="16" RowSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       x:Uid="Tuning_PlanLabel"
                                       Style="{StaticResource AppLabel}" />
                            <ctl:AppComboBox Grid.Row="0" Grid.Column="1"
                                             MinWidth="140"
                                             HorizontalAlignment="Right"
                                             ItemsSource="{x:Bind ViewModel.PowerPlanOptions}"
                                             SelectedIndex="{x:Bind ViewModel.PowerPlanIndex, Mode=TwoWay}"
                                             SelectionChanged="OnPowerSelectionChanged" />

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       x:Uid="Tuning_BoostLabel"
                                       Style="{StaticResource AppLabel}" />
                            <ctl:AppComboBox Grid.Row="1" Grid.Column="1"
                                             MinWidth="140"
                                             HorizontalAlignment="Right"
                                             ItemsSource="{x:Bind ViewModel.BoostOptions}"
                                             SelectedIndex="{x:Bind ViewModel.BoostIndex, Mode=TwoWay}"
                                             IsEnabled="{x:Bind ViewModel.PowerAvailable, Mode=OneWay}"
                                             SelectionChanged="OnPowerSelectionChanged" />

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       x:Uid="Tuning_ParkingLabel"
                                       Style="{StaticResource AppLabel}" />
                            <!-- 契约 v1.2：核心停放整组 IsEnabled 硬闸门绑 IsCoreParkingSupported
                                 （PowerAvailable=false 时后端保证该闸门同为 false）。
                                 IsEnabled 只能设在 Control 上：ContentControl 仅作闸门容器 -->
                            <ContentControl Grid.Row="2" Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            IsTabStop="False"
                                            IsEnabled="{x:Bind ViewModel.IsCoreParkingSupported, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Slider Width="140"
                                            Minimum="0"
                                            Maximum="100"
                                            StepFrequency="5"
                                            Value="{x:Bind ViewModel.ParkingValue, Mode=TwoWay}"
                                            ValueChanged="OnParkingValueChanged"
                                            VerticalAlignment="Center" />
                                    <!-- 红线二：Grid 叠加，命令直接绑定。
                                         参数 "Parking"，步进 5、钳制 0~100。
                                         宽度 76：左右各压一个 18px 的加减号后，
                                         中间仍留得住三位数（100）。 -->
                                    <Grid Width="76" Height="{StaticResource AppInputHeight}">
                                        <TextBox Style="{StaticResource AppTextBoxMono}"
                                                 MaxLength="3"
                                                 Text="{x:Bind ViewModel.ParkingText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="OnParkingTextChanged" />
                                        <Button Style="{StaticResource AppStepperButton}"
                                                Width="18" Height="28"
                                                Margin="2,0,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Content="&#x2013;"
                                                IsTabStop="False"
                                                Command="{x:Bind ViewModel.DecrementCommand}"
                                                CommandParameter="Parking" />
                                        <Button Style="{StaticResource AppStepperButton}"
                                                Width="18" Height="28"
                                                Margin="0,0,2,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Content="+"
                                                IsTabStop="False"
                                                Command="{x:Bind ViewModel.IncrementCommand}"
                                                CommandParameter="Parking" />
                                    </Grid>
                                    <TextBlock x:Uid="Tuning_PercentUnit"
                                               Style="{StaticResource AppDesc}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ContentControl>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 脏数据浮动保存条 ====================
             初始收起；显隐由 View 层 ShowDirtyBar / HideDirtyBar 驱动（x:Name 被 code-behind 引用）。 -->
        <Border x:Name="DirtyBar"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,28"
                Background="{ThemeResource AppPopupBackgroundBrush}"
                BorderBrush="{ThemeResource AppAccentBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18,10"
                Visibility="Collapsed">
            <Border.RenderTransform>
                <CompositeTransform x:Name="DirtyBarTransform" TranslateY="20" />
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock x:Uid="Tuning_DirtyText"
                           FontSize="13"
                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0" />
                <Button x:Uid="Tuning_Discard"
                        Style="{StaticResource AppButton}"
                        Click="OnDiscardClick" />
                <Button x:Uid="Tuning_SaveOverwrite"
                        Style="{StaticResource AppButtonPrimary}"
                        Click="OnSaveClick" />
                <Button x:Uid="Tuning_SaveAs"
                        Style="{StaticResource AppButton}"
                        Click="OnSaveAsClick" />
            </StackPanel>
        </Border>

        <!-- ==================== 写入期遮罩 ====================
             吞指针事件：SMU 写入期间任何输入都会被下一次写入带上 -->
        <Grid Background="{ThemeResource AppScrimBrush}"
              Visibility="{x:Bind local:UiConverters.ToVisibleWhenTrue(ViewModel.IsBusy)}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              Width="32" Height="32"
                              HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.BusyText, Mode=OneWay}"
                           FontSize="14" FontWeight="Medium"
                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Uid="Tuning_RollbackHint"
                           Style="{StaticResource AppDesc}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
