<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:Zentwik.App.Controls"
    xmlns:anim="using:Microsoft.UI.Xaml.Media.Animation">

    <!--
    ============================================================================
    Controls —— 全局控件模板（与 HTML 原型逐项对应）
    ============================================================================

    尺寸基线：按钮 32 / 小按钮 26 / 下拉 34 / 步进器 32 / 圆角 4（下拉 6、卡片 8）。

    【为什么每个控件都要自己一套模板】
    WinUI 的系统控件在浅色主题下是白底、在深色主题下跟随系统强调色。
    白底面板压在 Mica 上像未加载完的宿主；强调色一变产品身份就没了。
    所以所有会露出「面板」的控件都由本字典出模板，颜色只引用 Tokens.xaml 的令牌。
    -->

    <!-- ==================== 卡片 ==================== -->

    <Style x:Key="AppCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource AppCardPadding}" />
    </Style>

    <Style x:Key="AppInnerPanel" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AppComboCornerRadius}" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style x:Key="AppPill" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ==================== 按钮 ==================== -->

    <!--
    基础按钮的模板。状态色全部打在 BackgroundBorder 上，不用 Opacity 压整体：
    压整体会让文字一起变淡，而原型里悬停只提亮底色。
    -->
    <ControlTemplate x:Key="AppButtonTemplate" TargetType="Button">
        <Grid x:Name="Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="BackgroundBorder.Background" Value="{ThemeResource AppControlBackgroundHoverBrush}" />
                            <Setter Target="BackgroundBorder.BorderBrush" Value="{ThemeResource AppControlBorderHoverBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="BackgroundBorder.Background" Value="{ThemeResource AppControlBackgroundPressedBrush}" />
                            <Setter Target="BackgroundBorder.BorderBrush" Value="{ThemeResource AppControlBorderHoverBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="BackgroundBorder.Background" Value="{ThemeResource AppControlBackgroundDisabledBrush}" />
                            <Setter Target="ContentPresenter.Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Border x:Name="BackgroundBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />

            <ContentPresenter x:Name="ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              AutomationProperties.AccessibilityView="Raw" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="AppButton" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AppControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template" Value="{StaticResource AppButtonTemplate}" />
    </Style>

    <!--
    主按钮：强调色 15% 底 + 强调色文字 + 30% 强调色描边（原型的 .btn.primary）。
    不能复用基础模板 —— 那个模板的悬停态写死中性灰，主按钮一碰就变灰。
    -->
    <ControlTemplate x:Key="AppPrimaryButtonTemplate" TargetType="Button">
        <Grid x:Name="Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="BackgroundBorder.Background" Value="{ThemeResource AppAccentSoftHoverBrush}" />
                            <Setter Target="BackgroundBorder.BorderBrush" Value="{ThemeResource AppAccentBorderBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="BackgroundBorder.Background" Value="{ThemeResource AppAccentBorderBrush}" />
                            <Setter Target="BackgroundBorder.BorderBrush" Value="{ThemeResource AppAccentBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="BackgroundBorder.Background" Value="{ThemeResource AppControlBackgroundDisabledBrush}" />
                            <Setter Target="BackgroundBorder.BorderBrush" Value="{ThemeResource AppControlBorderBrush}" />
                            <Setter Target="ContentPresenter.Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Border x:Name="BackgroundBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />

            <ContentPresenter x:Name="ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              AutomationProperties.AccessibilityView="Raw" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="AppButtonPrimary" TargetType="Button" BasedOn="{StaticResource AppButton}">
        <Setter Property="Background" Value="{ThemeResource AppAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppAccentBorderBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template" Value="{StaticResource AppPrimaryButtonTemplate}" />
    </Style>

    <Style x:Key="AppButtonDanger" TargetType="Button" BasedOn="{StaticResource AppButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppErrorSoftBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppErrorBrush}" />
    </Style>

    <!-- 行内操作：26px / 12px / 圆角 4 -->
    <Style x:Key="AppButtonSmall" TargetType="Button" BasedOn="{StaticResource AppButton}">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="AppButtonSmallPrimary" TargetType="Button" BasedOn="{StaticResource AppButtonSmall}">
        <Setter Property="Background" Value="{ThemeResource AppAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppAccentBorderBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppAccentBrush}" />
        <Setter Property="Template" Value="{StaticResource AppPrimaryButtonTemplate}" />
    </Style>

    <Style x:Key="AppButtonSmallDanger" TargetType="Button" BasedOn="{StaticResource AppButtonSmall}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppErrorSoftBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppErrorBrush}" />
    </Style>

    <!-- ==================== 标题栏按钮（32×32） ==================== -->

    <Style x:Key="AppCaptionButton" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCaptionCornerRadius}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="BackgroundBorder.Background" Value="{ThemeResource AppCaptionHoverBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="BackgroundBorder.Background" Value="{ThemeResource AppCaptionPressedBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.3" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="BackgroundBorder" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />

                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppCaptionCloseButton" TargetType="Button" BasedOn="{StaticResource AppCaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="BackgroundBorder.Background" Value="{ThemeResource AppCloseHoverBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="#FFFFFFFF" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="BackgroundBorder.Background" Value="{ThemeResource AppClosePressedBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="#FFFFFFFF" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.3" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="BackgroundBorder" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />

                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 侧栏导航项 ====================
    用 ListBoxItem 定制而不是 NavigationView：NavigationView 的选中指示条尺寸、
    项高与圆角由 NavigationViewItemPresenter 内部固定，改不动 —— 只能做到「近似」，
    而原型里那条 3x16 的圆角高亮条是这个界面最关键的选中反馈。

    图标与文字统一用 AppTextPrimaryBrush，靠 ContentPresenter.Opacity 表达
    「次要 60% / 主要 100%」：这样文字和描边图标一起变亮，不会出现图标还是灰的。
    -->
    <Style x:Key="AppNavItem" TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,6,0,6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid x:Name="Root" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Background" Value="{ThemeResource AppNavItemHoverBrush}" />
                                        <Setter Target="ContentPresenter.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Background" Value="{ThemeResource AppControlBackgroundPressedBrush}" />
                                        <Setter Target="ContentPresenter.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.3" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected" />
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Background" Value="{ThemeResource AppNavItemSelectedBrush}" />
                                        <Setter Target="Indicator.Opacity" Value="1" />
                                        <Setter Target="ContentPresenter.Opacity" Value="1" />
                                        <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedUnfocused">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Background" Value="{ThemeResource AppNavItemSelectedBrush}" />
                                        <Setter Target="Indicator.Opacity" Value="1" />
                                        <Setter Target="ContentPresenter.Opacity" Value="1" />
                                        <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Background" Value="{ThemeResource AppNavItemHoverBrush}" />
                                        <Setter Target="Indicator.Opacity" Value="1" />
                                        <Setter Target="ContentPresenter.Opacity" Value="1" />
                                        <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Background" Value="{ThemeResource AppControlBackgroundPressedBrush}" />
                                        <Setter Target="Indicator.Opacity" Value="1" />
                                        <Setter Target="ContentPresenter.Opacity" Value="1" />
                                        <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="Chrome"
                                Background="Transparent"
                                CornerRadius="6" />

                        <!-- 3x16 圆角高亮条：左边缘垂直居中，只在选中时出现 -->
                        <Rectangle x:Name="Indicator"
                                   Width="3" Height="16"
                                   RadiusX="1.5" RadiusY="1.5"
                                   Fill="{ThemeResource AppAccentBrush}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Opacity="0" />

                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Margin="12,0,12,0"
                                          Opacity="0.6"
                                          VerticalAlignment="Center"
                                          HorizontalContentAlignment="Left"
                                          AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 组间分割线：1px，左右各缩进 8，上下各 16（原型 .nav-spacer-line）。
         用禁用的 ListBoxItem 承载，ListBox 的键盘导航会自动跳过它。 -->
    <Style x:Key="AppNavDivider" TargetType="ListBoxItem">
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Height" Value="33" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Height="1" Margin="8,0"
                            Background="{ThemeResource AppDividerBrush}"
                            VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 日志筛选徽章 ==================== -->

    <Style x:Key="AppPillToggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{ThemeResource AppControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Height" Value="26" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="BackgroundBorder.BorderBrush" Value="{ThemeResource AppControlBorderHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.7" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="BackgroundBorder.Background" Value="{ThemeResource AppAccentSoftBrush}" />
                                        <Setter Target="BackgroundBorder.BorderBrush" Value="{ThemeResource AppAccentBorderBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="BackgroundBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />

                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 数值步进器 ====================
    原型的 .number-box：[−] 数值 [+] 三段等分在 32px 高、4px 圆角的框里，
    数字 Consolas 14 Bold 居中。步进按钮无底无框，只在悬停时浮出一层。
    -->
    <Style x:Key="AppStepperButton" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Background" Value="{ThemeResource AppControlBackgroundHoverBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Background" Value="{ThemeResource AppControlBackgroundPressedBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.25" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppNumberStepper" TargetType="ctl:NumberStepper">
        <Setter Property="Background" Value="{ThemeResource AppControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctl:NumberStepper">
                    <Grid x:Name="Root" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.BorderBrush" Value="{ThemeResource AppControlBorderHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />

                        <Grid Margin="1,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="DownButton"
                                    Grid.Column="0"
                                    Style="{StaticResource AppStepperButton}"
                                    Content="&#x2013;"
                                    VerticalAlignment="Center" />
                            <TextBox x:Name="InputBox"
                                     Grid.Column="1"
                                     Height="30"
                                     MinWidth="0"
                                     Padding="0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     FontSize="14"
                                     FontWeight="Bold"
                                     Foreground="{TemplateBinding Foreground}"
                                     TextAlignment="Center"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="Transparent" />
                                </TextBox.Resources>
                            </TextBox>

                            <Button x:Name="UpButton"
                                    Grid.Column="2"
                                    Style="{StaticResource AppStepperButton}"
                                    Content="+"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ctl:NumberStepper" BasedOn="{StaticResource AppNumberStepper}" />

    <!-- ==================== 文本输入 ==================== -->

    <Style x:Key="AppTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>

    <!-- 数值输入：AppInputHeight 高、Consolas、居中 —— CO 网格 / FMax / 核心停放专用。
         【Padding 为什么是 20,7,20,0 而不是 4,0】
         WinUI 3 的 TextBox 模板里，内容区是一个 ScrollViewer（x:Name="ContentElement"），
         而 DefaultScrollViewerStyle 把 VerticalContentAlignment 写死成 Top ——
         结果就是 TextBox.VerticalContentAlignment 根本不生效，文字永远顶在框的上沿。
         红线②禁掉了重写 TextBox 模板，只能在样式层用内边距补偿：
             框高 32（AppInputHeight）/ 上下边框各 1 / 单行行高约 16
             上内边距 7 → 文字中心 = 1 + 7 + 8 = 16 = 框中心 → 视觉绝对居中
             下内边距 0 → 内容区高 23 > 行高 16，永远不会触发内部滚动条
         左右各 20 是给压在两端的加减号留位：数字只落在中间那截，不会被按钮压住。 -->
    <Style x:Key="AppTextBoxMono" TargetType="TextBox" BasedOn="{StaticResource AppTextBox}">
        <Setter Property="Height" Value="{StaticResource AppInputHeight}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource AppMonoFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Padding" Value="20,7,20,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    </Style>

    <!-- 图标按钮：36×36、圆角 6、次级控件底（无文字，配 ToolTip 使用） -->
    <Style x:Key="AppIconButton" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource AppIconButtonSize}" />
        <Setter Property="Height" Value="{StaticResource AppIconButtonSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Background" Value="{ThemeResource AppControlBackgroundHoverBrush}" />
                                        <Setter Target="Chrome.BorderBrush" Value="{ThemeResource AppControlBorderHoverBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Background" Value="{ThemeResource AppControlBackgroundPressedBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Background" Value="{ThemeResource AppControlBackgroundDisabledBrush}" />
                                        <Setter Target="ContentPresenter.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />

                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 下拉框 ==================== -->

    <!--
    下拉条目样式。
    【选中态为什么不再铺亮蓝色块】
    原来 Selected 态用的是 AppAccentSoftBrush（半透明亮青）打底 + AppAccentBrush 亮青字，
    在深色弹层上就是一块极其突兀的荧光色块。
    现在改成：淡灰底（AppControlBackgroundHoverBrush）+ 左侧一根 3px 青色细竖条表示选中，
    文字保持正文色 —— 选中与否一眼可辨，但不再抢戏。

    【视觉状态名】
    WinUI 3 实际用的是 Selected / SelectedPointerOver / SelectedPressed；
    UWP 时代的 PointerOverSelected / PressedSelected 在 WinUI 3 里根本不会被触发。
    两套名字都留着：命中哪套算哪套，绝不会因为状态名对不上而崩。
    -->
    <Style x:Key="AppComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid x:Name="Root"
                          Background="{TemplateBinding Background}"
                          CornerRadius="4"
                          Margin="4,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource AppRowHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource AppControlBackgroundPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource AppControlBackgroundHoverBrush}" />
                                        <Setter Target="SelectionMark.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource AppControlBackgroundHoverBrush}" />
                                        <Setter Target="SelectionMark.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource AppControlBackgroundPressedBrush}" />
                                        <Setter Target="SelectionMark.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource AppControlBackgroundHoverBrush}" />
                                        <Setter Target="SelectionMark.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PressedSelected">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource AppControlBackgroundPressedBrush}" />
                                        <Setter Target="SelectionMark.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- 选中标记：左侧一根细竖条，比整块亮色底克制得多。
                             Rectangle 没有 CornerRadius 属性，端头圆角用 RadiusX / RadiusY；
                             尺寸与圆角全部走 token。 -->
                        <Rectangle x:Name="SelectionMark"
                                   Grid.Column="0"
                                   Width="{StaticResource AppSelectionMarkWidth}"
                                   Height="{StaticResource AppSelectionMarkHeight}"
                                   Margin="0,0,4,0"
                                   RadiusX="{StaticResource AppSelectionMarkRadius}"
                                   RadiusY="{StaticResource AppSelectionMarkRadius}"
                                   VerticalAlignment="Center"
                                   Fill="{ThemeResource AppAccentBrush}"
                                   Visibility="Collapsed" />

                        <ContentPresenter x:Name="ContentPresenter"
                                          Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="6,4,10,4"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
    AppComboBox：完全重模板。必要命名部件：ContentPresenter / PlaceholderTextBlock /
    DropDownGlyph / Popup / ItemsPresenter —— ComboBox 的 code-behind 按名取，缺一个就是运行期空引用。

    【关闭态文字为什么走 TextBlock 而不是 ContentPresenter】
    ComboBox 基类会在运行时往 ContentPresenter 的 Content 上写值，
    模板里再绑 SelectionBoxItem 会被它顶掉（写成 null）→ 合上就是一片空白。
    所以 ContentPresenter 原样保留（命名部件不能少）但设为不可见，
    改用 TextBlock 显示 AppComboBox.DisplayText —— 一条与基类互不干扰的纯文本通道。

    【弹层滚动条】
    弹层内容通常只有个位数的条目，右侧却挂着一根带上下箭头的原生滚动条（宽 12px + 箭头），
    视觉上比弹层本身还抢眼。这里直接把滚动条藏掉：ScrollMode 保留 Enabled（条目多时仍可滚），
    滚动条可见性设为 Hidden。
    -->
    <Style x:Key="AppComboBoxStyle" TargetType="ctl:AppComboBox">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AppComboCornerRadius}" />
        <Setter Property="Height" Value="{StaticResource AppComboHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource AppComboBoxItemStyle}" />
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Enabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctl:AppComboBox">
                    <Grid x:Name="LayoutRoot" Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="0" />
                        </Grid.RowDefinitions>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HighlightBackground.Background" Value="{ThemeResource AppControlBackgroundHoverBrush}" />
                                        <Setter Target="HighlightBackground.BorderBrush" Value="{ThemeResource AppControlBorderHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HighlightBackground.Background" Value="{ThemeResource AppControlBackgroundPressedBrush}" />
                                        <Setter Target="HighlightBackground.BorderBrush" Value="{ThemeResource AppAccentBorderBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="HighlightBackground.Background" Value="{ThemeResource AppControlBackgroundDisabledBrush}" />
                                        <Setter Target="ContentPresenter.Opacity" Value="0.4" />
                                        <Setter Target="SelectionText.Opacity" Value="0.4" />
                                        <Setter Target="DropDownGlyph.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="HighlightBackground"
                                Grid.Row="0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />

                        <Grid Grid.Row="0" Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 关闭态文字：改由 SelectionText 显示。
                                 ComboBox 基类会在运行时往 ContentPresenter.Content 上写值，
                                 模板里的 TemplateBinding 会被它顶成 null —— 合上就是一片空白。
                                 ContentPresenter 是基类按名取的命名部件，不能删（删了就是运行期空引用），
                                 所以折叠起来只作占位，真正显示的是 SelectionText
                                 （AppComboBox.DisplayText，一条与基类互不干扰的纯文本通道）。 -->
                            <ContentPresenter x:Name="ContentPresenter"
                                              Grid.Column="0"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}"
                                              Visibility="Collapsed"
                                              AutomationProperties.AccessibilityView="Raw" />

                            <TextBlock x:Name="SelectionText"
                                       Grid.Column="0"
                                       Text="{TemplateBinding DisplayText}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False" />

                            <TextBlock x:Name="PlaceholderTextBlock"
                                       Grid.Column="0"
                                       Text="{TemplateBinding PlaceholderText}"
                                       Foreground="{ThemeResource AppTextMetaBrush}"
                                       FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed" />

                            <!-- 规范：禁用系统实心大三角，改用精致小箭头字符 -->
                            <TextBlock x:Name="DropDownGlyph"
                                      Grid.Column="1"
                                      Text="▼"
                                      FontSize="8"
                                      Margin="10,1,2,0"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      IsHitTestVisible="False" />
                        </Grid>

                        <Popup x:Name="Popup"
                               Grid.Row="1"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Left"
                               IsTabStop="False">
                            <Popup.ChildTransitions>
                                <TransitionCollection>
                                    <anim:EntranceThemeTransition FromVerticalOffset="8" />
                                </TransitionCollection>
                            </Popup.ChildTransitions>
                            <Border Background="{ThemeResource AppComboPopupBackgroundBrush}"
                                    BorderBrush="{ThemeResource AppPopupBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource AppComboCornerRadius}"
                                    Margin="0,4,0,0"
                                    Padding="0,4"
                                    MaxHeight="300">
                                <!-- 弹层内容通常只有个位数条目，却挂着一根带上下箭头的原生滚动条
                                     （宽 12px + 箭头），比弹层本身还抢眼。
                                     滚动模式保留 Auto（条目多时仍能滚），滚动条可见性藏掉。 -->
                                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                              VerticalScrollMode="Auto"
                                              HorizontalScrollMode="Disabled"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ctl:AppComboBox" BasedOn="{StaticResource AppComboBoxStyle}" />

    <!-- ============================================================================
         新增基元组件（breeze-shell 设计移植，全部用 Zentwik token 上色）
         度量已对齐 breeze-shell：卡片圆角 7 / 控件高 32 / 圆角 4（下拉 4、分段容器 6）
         ============================================================================ -->

    <!-- ==================== 页头 ==================== -->
    <!-- 用法：外层 Grid 用 AppPageHeader，标题/描述/操作区用配套子样式自由组合 -->
    <Style x:Key="AppPageHeader" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="ColumnSpacing" Value="16" />
    </Style>
    <Style x:Key="AppPageHeaderTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="AppPageHeaderDesc" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="AppPageHeaderActions" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- ==================== 内联通知 InfoBar（4 档语义，图标由内容放置） ==================== -->
    <Style x:Key="AppInfoBar" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource InfoBarInformationalSeverityBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14" />
    </Style>
    <Style x:Key="AppInfoBarWarning" TargetType="Border" BasedOn="{StaticResource AppInfoBar}">
        <Setter Property="Background" Value="{ThemeResource InfoBarWarningSeverityBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppWarnSoftBrush}" />
    </Style>
    <Style x:Key="AppInfoBarError" TargetType="Border" BasedOn="{StaticResource AppInfoBar}">
        <Setter Property="Background" Value="{ThemeResource InfoBarErrorSeverityBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppErrorSoftBrush}" />
    </Style>
    <Style x:Key="AppInfoBarSuccess" TargetType="Border" BasedOn="{StaticResource AppInfoBar}">
        <Setter Property="Background" Value="{ThemeResource InfoBarSuccessSeverityBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppAccentSoftBrush}" />
    </Style>

    <!-- ==================== 可折叠分组 Expander ==================== -->
    <Style x:Key="AppExpander" TargetType="Expander">
        <Setter Property="Background" Value="{ThemeResource AppCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCardCornerRadius}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- ==================== 分段选择 SegmentedControl ==================== -->
    <!-- 外层圆角容器；内部放若干 AppSegmentedItem(RadioButton)，同 GroupName 互斥 -->
    <Style x:Key="AppSegmentedControl" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AppSegmentedCornerRadius}" />
        <Setter Property="Padding" Value="2" />
    </Style>
    <Style x:Key="AppSegmentedItem" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="BackgroundBorder.Background" Value="{ThemeResource AppControlBackgroundHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="BackgroundBorder.Background" Value="{ThemeResource AppControlBackgroundPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <!-- CheckStates 声明在 CommonStates 之后：选中态优先于悬停，保证选中项不变灰 -->
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="BackgroundBorder.Background" Value="{ThemeResource AppAccentBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppOnAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="BackgroundBorder" Background="{TemplateBinding Background}" CornerRadius="{StaticResource AppControlCornerRadius}" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Padding="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 可选卡片 ChoiceCard（左侧 3px 青色竖条 = 选中，与 ComboBox 选中态语言一致） ==================== -->
    <Style x:Key="AppChoiceCard" TargetType="RadioButton">
        <Setter Property="Background" Value="{ThemeResource AppCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCardCornerRadius}" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="CardBorder.Background" Value="{ThemeResource AppControlBackgroundHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="CardBorder.BorderBrush" Value="{ThemeResource AppAccentBorderBrush}" />
                                        <Setter Target="AccentBar.Opacity" Value="1" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked">
                                    <VisualState.Setters>
                                        <Setter Target="AccentBar.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{ThemeResource AppTextSecondaryBrush}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <!-- 左侧 3px 青色选中竖条（Z 序在卡片之上） -->
                        <Rectangle x:Name="AccentBar"
                                   HorizontalAlignment="Left" Width="3"
                                   Fill="{ThemeResource AppAccentBrush}" Opacity="0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 进度条 ProgressBar ==================== -->
    <Style x:Key="AppProgressBar" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{ThemeResource AppAccentBrush}" />
        <Setter Property="Background" Value="{ThemeResource AppControlBackgroundBrush}" />
        <Setter Property="Height" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ==================== 设置行卡片 SettingsCard（TuningPage 高频布局：左标签+描述 / 右控件） ==================== -->
    <Style x:Key="AppSettingsCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCardCornerRadius}" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="AppSettingsLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="AppSettingsDesc" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ==================== 开关 ToggleSwitch（原生模板已通过 Tokens 青色化，此处仅统一样式） ==================== -->
    <Style x:Key="AppToggleSwitch" TargetType="ToggleSwitch">
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinWidth" Value="0" />
    </Style>

</ResourceDictionary>
